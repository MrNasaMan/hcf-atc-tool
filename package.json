{
  "name": "hcf-atc-tool",
  "version": "3.0.0",
  "description": "Honolulu Control Facility ATC Tool",
  "author": "Davit Karapetyan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hcf.atctool",
    "productName": "HCF ATC Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "logo.png",
      "artifactName": "${productName} ${target}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName} Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "MrNasaMan",
      "repo": "hcf-atc-tool"
    }
  }
}